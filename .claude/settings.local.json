{
  "permissions": {
    "allow": [
      "WebFetch(domain:chromium.googlesource.com)"
    ],
    "additionalDirectories": [
      "/private/tmp"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/rappel-mecanismes.sh"
          }
        ]
      }
    ]
  }
}
